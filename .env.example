AERIS_ENV=development
AERIS_APP_NAME=AERIS-X
AERIS_VERSION=0.14.0
DATABASE_URL=postgresql+psycopg://aeris@localhost:5432/aeris
LOG_LEVEL=INFO
AERIS_MAX_REQUEST_BODY_BYTES=2000000
AERIS_MAX_TELEMETRY_ROWS=1000
AERIS_MAX_TELEMETRY_FEATURES=256
AERIS_MAX_HISTORY_LIMIT=100
# Comma-separated allowlists; leave empty for local development.
AERIS_CORS_ORIGINS=
AERIS_TRUSTED_HOSTS=
