{
  "experiment": "Step 12 multi-dataset health-state evaluation",
  "python": "3.11.9",
  "pytorch": "2.11.0+cu128",
  "datasets": [
    "FD001",
    "FD002",
    "FD003",
    "FD004"
  ],
  "seed": 42,
  "device": "cpu",
  "architecture": {
    "model": "existing TransformerRegressor",
    "input_features": 15,
    "window_size": 30,
    "d_model": 64,
    "heads": 4,
    "layers": 2,
    "dropout": 0.1
  },
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "batch_size": 128,
  "epochs": 8,
  "health_label": "clip(RUL / max(training-split RUL), 0, 1)",
  "transfer_health_reference": "FD001 training RUL maximum only",
  "artifacts": [
    "dataset_characterization.json",
    "split_manifest.json",
    "preprocessing_manifest.json",
    "leakage_audit.json"
  ]
}